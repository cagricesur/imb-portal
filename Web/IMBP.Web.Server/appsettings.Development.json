{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PortalContext": "Data Source=(LocalDb)\\MSSQLLocalDB;Initial Catalog=IMB-Portal;Integrated Security=True;Trust Server Certificate=True"
  },
  "MemoryCache": {
    "CompactionPercentage": 0.25,
    "ExpirationScanFrequency": "00:01:00",
    "TrackStatistics": false
  },
  "JwtSettings": {
    "Secret": "IMB-Portal-Development-Secret-Key-At-Least-32-Chars",
    "Issuer": "IMB-Portal",
    "Audience": "IMB-Portal",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30,
    "EnforceSingleSession": true,
    "CookieSecure": true,
    "CookieNames": {
      "AccessToken": "imb-portal-access",
      "RefreshToken": "imb-portal-refresh"
    }
  },
  "Authentication": {
    "DevCredentials": {
      "Enabled": true,
      "Password": "Password123!"
    }
  }
}
